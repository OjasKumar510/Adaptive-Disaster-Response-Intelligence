import cv2
import numpy as np
from ultralytics import YOLO

# -------------------------------------------------------------------
# CONFIGURATION
# -------------------------------------------------------------------
# Target COCO class IDs: car (2), motorcycle (3), bus (5), truck (7)
VEHICLE_CLASSES = [2, 3, 5, 7]

# Passenger Car Equivalent (PCE) weights to account for physical size
VEHICLE_WEIGHTS = {
    2: 1.0,  # car
    3: 0.5,  # motorcycle
    5: 2.5,  # bus
    7: 2.0   # truck
}

# Estimated maximum road capacity in weighted vehicle units (PCE)
# Adjust based on camera view (e.g., 20.0 for a short lane section, 50.0 for highway)
MAX_ROAD_CAPACITY_PCE = 20.0  

def calculate_traffic_density(counts, weights, max_capacity):
    """
    Calculates normalized traffic volume density bounded between 0.0 and 1.0.
    """
    # Calculate weighted total vehicle count
    total_pce = sum(counts[cls_id] * weights[cls_id] for cls_id in counts)
    
    # Normalize density between 0.0 and 1.0
    raw_density = total_pce / max_capacity
    traffic_density = float(np.clip(raw_density, 0.0, 1.0))
    
    # Categorize traffic condition based on density score
    if traffic_density < 0.3:
        status = "Low Traffic (Free Flow)"
    elif traffic_density < 0.7:
        status = "Moderate Traffic"
    else:
        status = "Heavy Traffic (Congested)"
        
    return traffic_density, total_pce, status


def process_image_traffic(image_path, model_path="yolov8n.pt", conf_thresh=0.25):
    # 1. Load pretrained YOLO model (e.g., yolov8n.pt, yolov8m.pt)
    model = YOLO(model_path)
    
    # 2. Run inference filtering strictly for target vehicle classes
    # The 'classes' parameter forces YOLO to ignore non-vehicle detections
    results = model.predict(source=image_path, classes=VEHICLE_CLASSES, conf=conf_thresh)[0]
    
    # 3. Count detected vehicles per class ID
    counts = {cls_id: 0 for cls_id in VEHICLE_CLASSES}
    boxes = results.boxes
    
    for box in boxes:
        cls_id = int(box.cls[0])
        if cls_id in counts:
            counts[cls_id] += 1
            
    # 4. Calculate Density Score (0 to 1)
    density_score, total_pce, status = calculate_traffic_density(
        counts, VEHICLE_WEIGHTS, MAX_ROAD_CAPACITY_PCE
    )
    
    # 5. Visualize Results on Image
    annotated_img = results.plot()  # Draws bounding boxes on image matrix
    
    # Overlay density information on the frame
    overlay_text = f"Density: {density_score:.2f} ({status})"
    count_text = f"Cars: {counts[2]} | Bikes: {counts[3]} | Buses: {counts[5]} | Trucks: {counts[7]}"
    
    cv2.putText(annotated_img, overlay_text, (20, 40), 
                cv2.FONT_HERSHEY_SIMPLEX, 0.9, (0, 255, 0), 2)
    cv2.putText(annotated_img, count_text, (20, 80), 
                cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 2)
    
    return {
        "density_score": density_score,
        "total_vehicles_raw": sum(counts.values()),
        "weighted_pce_count": total_pce,
        "class_counts": counts,
        "traffic_status": status,
        "annotated_image": annotated_img
    }
